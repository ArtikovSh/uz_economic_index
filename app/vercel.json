{
  "builds": [
    { "src": "api/bot.py", "use": "@vercel/python" },
    { "src": "api/data.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/bot", "dest": "/api/bot.py" },
    { "src": "/api/data", "dest": "/api/data.py" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
